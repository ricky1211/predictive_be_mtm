# ====================================================================
# PT MENARA TERUS MAKMUR - MTM BACKEND PREDICTIVE (PdM) ENVIRONMENT
# ====================================================================

# Port API Predictive
PORT=4001
API_PORT=4001

# MQTT Ingestion Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=mtm/jingduanforging/#
MQTT_CLIENT_ID=mtm_pdm_subscriber_4001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# PostgreSQL Timescale (Time-series Telemetry Storage)
ENABLE_TIMESCALE=true
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=timescale_db
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres

# PostgreSQL Device Monitoring State
ENABLE_MONITORING=true
MONITORING_HOST=localhost
MONITORING_PORT=5432
MONITORING_DB=monitoring_db
MONITORING_USER=postgres
MONITORING_PASSWORD=postgres

# WhatsApp Emergency Alert Bot (Baileys)
ENABLE_WA_NOTIF=true
WA_TARGET_PHONE=
MQTT_DATA_TIMEOUT_SECONDS=180

# Integrasi Antar-Layanan (Webhook ke Backend Preventive)
PREVENTIVE_WEBHOOK_URL=http://localhost:4002/api/internal/alert-wo
